# ==============================================================================
# Agent-1 (Document Q&A RAG Agent) Configuration
# ==============================================================================

# Google Cloud Project Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=europe-west3
GCS_STAGING_BUCKET=gs://your-gcs-staging-bucket-name

# Gemini API Key (for local dev / embeddings without ADC)
GEMINI_API_KEY=your-gemini-api-key

# Embedding & LLM Models
MODEL_NAME=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# Active Vector Store Backend ("cloudsql" or "firestore")
VECTOR_BACKEND=firestore

# ------------------------------------------------------------------------------
# 1. Cloud SQL for PostgreSQL (pgvector on db-f1-micro) Configuration
# ------------------------------------------------------------------------------
# For local connection via Cloud SQL Auth Proxy or direct IP:
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-secure-db-password

# Optional: Cloud SQL instance connection name for Unix socket / Cloud Run
# Format: project-id:region:instance-id
# CLOUD_SQL_CONNECTION_NAME=your-gcp-project:europe-west3:my-pg-instance

# ------------------------------------------------------------------------------
# 2. Cloud Firestore Vector Search Configuration
# ------------------------------------------------------------------------------
FIRESTORE_COLLECTION=document_chunks
FIRESTORE_DATABASE=(default)

# ------------------------------------------------------------------------------
# Authentication & Whitelist Access Control
# ------------------------------------------------------------------------------
ALLOWED_USERS=user@example.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Vertex AI Agent Engine Instance (Optional: set when deployed)
REASONING_ENGINE_ID=projects/YOUR_PROJECT_ID/locations/YOUR_REGION/reasoningEngines/YOUR_ENGINE_ID

# Server Configuration
PORT=8083

# Frontend Google OAuth Client ID (in frontend/.env)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_API_URL=http://localhost:8083
